---
import { getEntry, render } from 'astro:content';
import PlainLayout from '../layouts/PlainLayout.astro';

const page = await getEntry('pages', 'gaiden');

if (!page) {
  throw new Error('src/content/pages/gaiden.md が見つかりません。');
}

const { Content } = await render(page);
---

<PlainLayout {...page.data} robots="noindex, nofollow">
  <Content />
</PlainLayout>
