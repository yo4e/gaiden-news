---
import { getEntry, render } from 'astro:content';
import EditorialLayout from '../layouts/EditorialLayout.astro';
import KineticLayout from '../layouts/KineticLayout.astro';
import PlainLayout from '../layouts/PlainLayout.astro';
import { ACTIVE_THEME } from '../config/themes';

const page = await getEntry('pages', 'gaiden');

if (!page) {
  throw new Error('src/content/pages/gaiden.md が見つかりません。');
}

const { Content } = await render(page);
const Layout = ACTIVE_THEME === 'plain'
  ? PlainLayout
  : ACTIVE_THEME === 'kinetic-2026'
    ? KineticLayout
    : EditorialLayout;
---

<Layout {...page.data}>
  <Content />
</Layout>
